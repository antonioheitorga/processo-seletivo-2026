# LLM — Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./dados/vectorstore

# Retriever
# 0.78 calibrado empiricamente contra o benchmark (evaluation/dataset.json):
# perguntas respondíveis pelo corpus, após reformulação, pontuam >= 0.799;
# perguntas fora de escopo (fallback por design) ficam <= 0.764.
# Ver dev/retriever_threshold_probe.py e evaluation/README.md.
RETRIEVER_THRESHOLD=0.78

# Tavily (busca web)
TAVILY_API_KEY=

# Traces
TRACES_DIR=./traces

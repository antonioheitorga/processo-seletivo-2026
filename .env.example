# LLM — Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./dados/vectorstore

# Retriever
RETRIEVER_THRESHOLD=0.7

# Tavily (busca web)
TAVILY_API_KEY=

# Verifier — loop de reflexão
VERIFIER_MAX_RETRIES=1

# Traces
TRACES_DIR=./traces
